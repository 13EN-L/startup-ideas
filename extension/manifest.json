{
  "manifest_version": 3,
  "name": "FocusGarden",
  "version": "0.1.0",
  "description": "Set a task, study normally, and grow a garden from time an AI confirms was on-task.",
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "FocusGarden"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"]
}

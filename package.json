{
  "name": "focusgarden",
  "version": "1.0.0",
  "description": "Desktop focus tracker: tasks grow a pixel-art garden, with Claude labeling your apps and sites on-task or off-task.",
  "main": "./out/main/index.js",
  "author": {
    "name": "FocusGarden team",
    "url": "https://github.com/13EN-L/startup-ideas"
  },
  "homepage": "https://github.com/13EN-L/startup-ideas",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run fetch:aw && npm run build && node scripts/package.mjs --dir",
    "build:win": "node scripts/fetch-activitywatch.mjs --platform windows-x86_64 && npm run build && node scripts/package.mjs --win",
    "build:mac": "npm run fetch:aw && npm run build && node scripts/package.mjs --mac",
    "build:linux": "node scripts/fetch-activitywatch.mjs --platform linux-x86_64 && npm run build && node scripts/package.mjs --linux",
    "test": "vitest run --passWithNoTests",
    "test:mutation": "stryker run",
    "fetch:aw": "node scripts/fetch-activitywatch.mjs",
    "make:art": "node scripts/make-placeholders.cjs",
    "setup:mac-signing": "node scripts/setup-mac-signing.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
